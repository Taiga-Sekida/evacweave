# Development defaults. Do not put credentials in this file.

# Fine-tuned Gemma Cloud Run service (production/runtime integration)
GEMMA_SERVICE_URL=
GEMMA_SERVICE_AUDIENCE=
GEMMA_MAX_CALLS_PER_RUN=30

# Vertex Gemini orchestrator. The service defaults to gemini-3.5-flash (allowlist: apps/orchestrator_service/main.py).
# gemini-2.5-flash is retired on Vertex AI on 2026-10-20 and is rejected.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=
GEMINI_MAX_CALLS_PER_RUN=2

# GPU serving container
ADAPTER_REGISTRY_PATH=/models/adapter_registry.json
GEMMA_ROLE=resident
GEMMA_MAX_NEW_TOKENS=256
